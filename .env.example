# Required — shared token for portal-to-registry auth
NEXUS_TOKEN=change-me

# Required — random secret for signing session cookies (min 32 chars)
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-use-openssl-rand-hex-32

# Optional — initial admin password (only needed when the users table is empty)
# Remove after the admin has changed their password on first login.
NEXUS_INITIAL_PASSWORD=nexus-admin

# Database connection — defaults to SQLite at /data/portal.db
# SQLite (default):
# DATABASE_URL=sqlite:/data/portal.db
#
# PostgreSQL:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
#
# MySQL / MariaDB:
# DATABASE_URL=mysql://user:pass@host:3306/dbname
# DATABASE_URL=mariadb://user:pass@host:3306/dbname

# Optional — registry and gateway URLs (defaults work with the bundled compose stack)
# REGISTRY_URL=http://registry:8670
# GATEWAY_URL=http://gateway:80

# Optional — gateway URL (only needed for federation proxy in the portal)
# GATEWAY_URL=http://gateway:8668

# Optional — session lifetime in seconds (default 43200 = 12 hours)
# SESSION_TTL_SECONDS=43200
