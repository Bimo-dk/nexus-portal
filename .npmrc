# GitHub Packages scope mapping for @bimo-dk/*
@bimo-dk:registry=https://npm.pkg.github.com

# Auth — env-var NODE_AUTH_TOKEN sættes automatisk af actions/setup-node i CI.
# Lokal dev: eksporter NODE_AUTH_TOKEN=<din-PAT-med-read:packages> før npm install.
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

# Angular 19 peer-deps
legacy-peer-deps=true
