{
  "name": "nexus-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run build:client && npm run build:server",
    "build:client": "ng build --configuration production",
    "build:server": "tsc -p tsconfig.server.json",
    "build:prod": "npm run build",
    "watch": "ng build --watch --configuration development",
    "serve": "node dist/server/index.js",
    "predev": "node ./scripts/check-deps.mjs",
    "dev": "concurrently -n bff,ng -c blue,magenta -k --handle-input \"npm:dev:server\" \"npm:start\"",
    "dev:server": "node ./scripts/dev-server.mjs",
    "dev:reset": "node ./scripts/dev-reset.mjs"
  },
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/cdk": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/material": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@angular-architects/native-federation": "^19.0.13",
    "@bimo-dk/nexus-core": "^1.0.0",
    "@bimo-dk/nexus-runtime": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "cookie-parser": "^1.4.7",
    "knex": "^3.1.0",
    "mysql2": "^3.11.0",
    "pg": "^8.13.0",
    "es-module-shims": "^1.10.0",
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.3",
    "morgan": "^1.10.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "ws": "^8.18.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/build": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/pg": "^8.11.0",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
